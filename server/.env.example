# Variables de entorno del backend de Motorix.
# Copiar este archivo a .env y completar los valores locales.
# NUNCA se versiona .env ni se agregan secretos reales a este archivo.

# Servidor
PORT=3000

# Base de datos MySQL local (usuario dedicado del proyecto, NUNCA root)
DB_HOST=localhost
DB_PORT=3306
DB_USER=motorix_app
DB_PASSWORD=cambiar_en_local
DB_NAME=motorix

# Base de datos de pruebas (Jest + supertest)
DB_TEST_NAME=motorix_test

# Seguridad
# Secreto para firmar los JWT; generar uno propio en cada entorno local
JWT_SECRET=cambiar_en_local_por_un_valor_largo_y_aleatorio

# Mercado Pago (Sprint 4) — research D6: credenciales SOLO en el entorno,
# nunca en la base de datos (RN-14). Vaciar estos valores tras copiar.
# MP_MODE: 'sandbox' para el proveedor real de pruebas o 'simulated' para el
# simulador interno (pruebas automatizadas y demo sin red).
MP_MODE=simulated
MP_ACCESS_TOKEN=cambiar_en_local_con_el_token_de_pruebas
